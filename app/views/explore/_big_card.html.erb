<%= link_to recipe, class: class_names("shelf--big-card", local_assigns[:extra_class]) do %>
  <% if recipe.image_url.present? %>
    <img src="<%= recipe.image_url %>" alt="" class="shelf--big-card-image">
  <% else %>
    <div class="shelf--big-card-image shelf--big-card-image-placeholder" aria-hidden="true"></div>
  <% end %>

  <p class="shelf--big-card-caption">
    <%= truncate(recipe.title, length: 42) %>
    <% if recipe.source_domain.present? %>
      <span class="shelf--big-card-dot" aria-hidden="true">&middot;</span>
      <span class="shelf--big-card-domain"><%= recipe.source_domain %></span>
    <% end %>
  </p>
<% end %>
