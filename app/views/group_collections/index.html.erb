<% manager = @group.manager?(Current.user) %>

<section class="group-settings">
  <div class="group-settings--inner">
    <%= render "groups/settings_header", group: @group, active_tab: :collections %>

    <% if flash[:alert] %>
      <div class="settings-alert"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice] %>
      <div class="settings-notice"><%= flash[:notice] %></div>
    <% end %>

    <div class="collections--card">
      <%= render partial: "collection", collection: @collections, as: :collection, locals: { group: @group, manager: manager } %>
    </div>

    <% if manager %>
      <div class="collections--new" data-controller="collection-form">
        <button type="button" class="btn btn--primary" data-collection-form-target="display" data-action="click->collection-form#show">
          <%= render "icons/plus" %>
          Ny samling
        </button>

        <div data-collection-form-target="form" hidden>
          <%= form_with model: Collection.new, url: group_collections_path(@group), class: "collections--form" do |form| %>
            <%= form.text_field :name, placeholder: "Namn på samlingen", class: "collections--field", data: { collection_form_target: "field" } %>
            <%= form.submit "Skapa", class: "collections--submit" %>
            <button type="button" class="collections--action" data-action="click->collection-form#hide">Avbryt</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
