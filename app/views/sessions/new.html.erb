<section class="auth-flow">
  <div class="auth-flow--card">
    <p class="auth-flow--title">Logga in</p>
    <p class="auth-flow--subtitle">Välkommen tillbaka.</p>

    <% if flash[:alert] %>
      <div class="auth-flow--error"><p><%= flash[:alert] %></p></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="auth-flow--notice"><p><%= flash[:notice] %></p></div>
    <% end %>

    <%= form_with url: session_path do |form| %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "E-postadress", value: params[:email_address], class: "auth-flow--field" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Lösenord", maxlength: 72, class: "auth-flow--field" %>

      <div class="auth-flow--actions">
        <%= form.submit "Logga in", class: "btn btn--primary" %>
      </div>
    <% end %>

    <p class="auth-flow--footer">
      <%= link_to "Glömt lösenordet?", new_password_path %><br>
      Inget konto? <%= link_to "Skapa ett", signup_path %>
    </p>
  </div>
</section>
