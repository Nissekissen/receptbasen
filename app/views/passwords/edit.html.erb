<section class="auth-flow">
  <div class="auth-flow--card">
    <p class="auth-flow--title">Nytt lösenord</p>
    <p class="auth-flow--subtitle">Välj ett nytt lösenord för ditt konto.</p>

    <% if flash[:alert] %>
      <div class="auth-flow--error"><p><%= flash[:alert] %></p></div>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "Nytt lösenord", maxlength: 72, class: "auth-flow--field" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Upprepa nytt lösenord", maxlength: 72, class: "auth-flow--field" %>

      <div class="auth-flow--actions">
        <%= form.submit "Spara nytt lösenord", class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</section>
