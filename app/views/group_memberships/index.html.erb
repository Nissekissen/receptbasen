<% owner = Current.user == @group.owner %>
<% manager = @group.manager?(Current.user) %>

<section class="group-settings">
  <div class="group-settings--inner">
    <%= render "groups/settings_header", group: @group, active_tab: :members %>

    <div class="settings-card">
      <% @memberships.each do |membership| %>
        <div class="member-row">
          <div class="member-row--identity">
            <span class="member-avatar"><%= member_initials(membership.user) %></span>
            <div>
              <p class="member-name"><%= membership.user.name %></p>
              <% if (role = group_role_label(@group, membership)) %>
                <span class="role-badge <%= role == "Ägare" ? "role-badge--owner" : "role-badge--admin" %>"><%= role %></span>
              <% end %>
            </div>
          </div>

          <% if membership.user != @group.owner %>
            <div class="member-row--actions">
              <% if owner %>
                <%= button_to (membership.admin? ? "Ta bort adminrättigheter" : "Gör till admin"),
                      group_membership_path(@group, membership), method: :patch, class: "collections--action" %>
              <% end %>

              <% if manager %>
                <%= button_to "Ta bort", group_membership_path(@group, membership), method: :delete,
                      class: "collections--action collections--action-delete",
                      form: { data: { turbo_confirm: "Ta bort #{membership.user.name} från gruppen?" } } %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
