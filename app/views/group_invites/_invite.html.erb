<div class="collections--row">
  <div class="collections--row-display">
    <div class="collections--meta">
      <div class="invite-link-group" data-controller="clipboard">
        <input type="text" class="invite-link-field" value="<%= invite_url(invite.token) %>" readonly data-clipboard-target="source">
        <button type="button" class="collections--action" data-action="click->clipboard#copy" data-clipboard-target="label">Kopiera</button>
      </div>
      <span class="collections--count">Skapad av <%= invite.created_by.name %> · <%= invite.created_at.strftime("%-d %b %Y") %></span>
    </div>

    <div class="collections--actions">
      <%= button_to "Återkalla", group_invite_path(group, invite), method: :delete,
            class: "collections--action collections--action-delete",
            form: { data: { turbo_confirm: "Återkalla den här inbjudningslänken? Den slutar fungera direkt." } } %>
    </div>
  </div>
</div>
