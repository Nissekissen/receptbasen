<section class="group-settings">
  <div class="group-settings--inner">
    <%= render "groups/settings_header", group: @group, active_tab: :general %>

    <% if flash[:alert] %>
      <div class="settings-alert"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice] %>
      <div class="settings-notice"><%= flash[:notice] %></div>
    <% end %>

    <div class="settings-card settings-card--padded">
      <% if @group.manager?(Current.user) %>
        <%= form_with model: @group, url: group_path(@group), method: :patch do |form| %>
          <div class="field-group">
            <%= form.label :name, "Namn" %>
            <%= form.text_field :name, class: "field" %>
          </div>

          <%= form.submit "Spara ändringar", class: "btn btn--primary" %>
        <% end %>
      <% else %>
        <p class="settings-readonly-name"><%= @group.name %></p>
      <% end %>
    </div>

    <% if Current.user == @group.owner %>
      <div class="danger-zone">
        <p class="danger-zone--title">Farlig zon</p>
        <div class="danger-zone--row">
          <div>
            <p class="danger-zone--label">Ta bort grupp</p>
            <p class="danger-zone--hint"><%= group_delete_warning(@group) %></p>
          </div>

          <%= button_to "Ta bort grupp", group_path(@group), method: :delete,
                class: "collections--action collections--action-delete",
                form: { data: { turbo_confirm: group_delete_confirm(@group) } } %>
        </div>
      </div>
    <% end %>
  </div>
</section>
