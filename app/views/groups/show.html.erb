<section class="group-show">
  <div class="group-show--inner">
    <header class="group-show--header">
      <div class="group-show--info">
        <div class="group-show--heading">
          <h1 class="group-show--title"><%= @group.name %></h1>
          <span class="group-show--badge">
            <% unless @group.public? %>
              <%= render "icons/lock" %>
            <% end %>
            <%= @group.public? ? "PUBLIK" : "PRIVAT" %>
          </span>
        </div>

        <div class="group-show--meta">
          <div class="group-show--avatars">
            <% @group.members.first(4).each do |member| %>
              <span class="group-show--avatar"><%= member_initials(member) %></span>
            <% end %>
          </div>
          <span class="group-show--member-count"><%= pluralize(@group.members.count, "medlem", plural: "medlemmar") %></span>
        </div>
      </div>

      <div class="group-show--actions">
        <button type="button" class="btn btn--secondary" disabled>
          <%= render "icons/link" %>
          Dela inbjudan
        </button>
        <button type="button" class="group-show--settings" aria-label="Inställningar" disabled>
          <%= render "icons/sliders" %>
        </button>
      </div>
    </header>

    <%= render "recipes/filter_bar", url: group_path(@group), manage_path: nil %>

    <% if @recipes.any? %>
      <div class="recipes-index--grid">
        <% @recipes.each do |recipe| %>
          <% saved = saved_recipe_lookup(recipe) %>
          <div class="recipes-index--card-wrap">
            <%= link_to recipe, class: "recipes-index--card" do %>
              <%= render "recipes/preview_card", recipe: recipe, index_card: true, attribution: @attributions[recipe.id] %>
            <% end %>

            <div class="recipe-preview--save-wrap" data-controller="dropdown save-menu">
              <button type="button" class="recipe-preview--save" data-action="click->dropdown#toggle" data-save-menu-target="trigger" aria-label="Spara">
                <%= render "icons/bookmark", filled: saved.any? %>
              </button>

              <%= render "recipes/save_menu", recipe: recipe, saved: saved %>
            </div>
          </div>
        <% end %>
      </div>
    <% elsif active_recipe_filters(collections: @collections).any? %>
      <p class="recipes-index--empty">Inga recept matchar filtren.</p>
    <% else %>
      <p class="group-show--placeholder">Inga recept sparade än i den här gruppen.</p>
    <% end %>
  </div>
</section>
