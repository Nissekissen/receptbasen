<section class="group-show">
  <div class="group-show--inner">
    <header class="group-show--header">
      <div class="group-show--info">
        <div class="group-show--heading">
          <h1 class="group-show--title"><%= @group.name %></h1>
          <span class="group-show--badge">
            <% unless @group.public? %>
              <%= render "icons/lock" %>
            <% end %>
            <%= @group.public? ? "PUBLIK" : "PRIVAT" %>
          </span>
        </div>

        <div class="group-show--meta">
          <div class="group-show--avatars">
            <% @group.members.first(4).each do |member| %>
              <span class="group-show--avatar"><%= member_initials(member) %></span>
            <% end %>
          </div>
          <span class="group-show--member-count"><%= pluralize(@group.members.count, "medlem", plural: "medlemmar") %></span>
        </div>
      </div>

      <div class="group-show--actions">
        <button type="button" class="btn btn--secondary" disabled>
          <%= render "icons/link" %>
          Dela inbjudan
        </button>
        <button type="button" class="group-show--settings" aria-label="Inställningar" disabled>
          <%= render "icons/sliders" %>
        </button>
      </div>
    </header>

    <div class="group-show--placeholder">
      <p>Inga samlingar än i den här gruppen.</p>
    </div>
  </div>
</section>
