<header class="navbar" data-controller="navbar mobile-menu">
    <div class="navbar--brand">
      <%= link_to root_path, class: "logo" do %>
        <%= render "icons/logo" %>
        Receptbasen
      <% end %>
    </div>

    <% if authenticated? %>
      <nav class="navbar--links">
        <%= link_to "Mina recept", recipes_path, class: "navbar--nav-link" %>
        <%= link_to "Grupper", groups_path, class: "navbar--nav-link" %>
      </nav>
    <% end %>

    <% if authenticated? %>
      <div class="navbar--group">
      <%= link_to new_recipe_path, class: "btn btn--primary navbar--cta" do %>
        <%= render "icons/plus" %>
        <span class="navbar--cta-label">Nytt recept</span>
      <% end %>
      <div class="navbar--user" data-controller="dropdown">
        <button type="button" class="navbar--user-toggle" data-action="click->dropdown#toggle">
          <%= Current.user.name %>
          <svg class="navbar--chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m6 9 6 6 6-6"/>
          </svg>
        </button>



            <div class="navbar--dropdown" data-dropdown-target="menu" hidden>
            <%= link_to "Samlingar", collections_path, class: "navbar--dropdown-item" %>
            <%= link_to "Profil", profile_path, class: "navbar--dropdown-item" %>
            <%= button_to "Logga ut", session_path, method: :delete, class: "navbar--dropdown-item" %>
            </div>
        </div>

        <button type="button" class="navbar--menu-toggle" data-mobile-menu-target="toggle" data-action="click->mobile-menu#open" aria-label="Öppna meny" aria-expanded="false" aria-controls="mobile-menu">
          <%= render "icons/menu" %>
        </button>
      </div>
    <% else %>
      <%= link_to "Logga in", login_path, class: "btn btn--secondary inverted navbar--guest" %>
    <% end %>

    <% if authenticated? %>
      <div class="navbar--scrim" data-mobile-menu-target="scrim" data-action="click->mobile-menu#close" hidden></div>

      <nav id="mobile-menu" class="navbar--drawer" data-mobile-menu-target="drawer" aria-label="Meny" hidden>
        <div class="navbar--drawer-head">
          <button type="button" class="navbar--drawer-close" data-mobile-menu-target="closeButton" data-action="click->mobile-menu#close" aria-label="Stäng meny">
            <%= render "icons/close" %>
          </button>
        </div>

        <div class="navbar--drawer-list">
          <%= link_to "Mina recept", recipes_path, class: "navbar--drawer-link" %>
          <%= link_to "Grupper", groups_path, class: "navbar--drawer-link" %>

          <div class="navbar--drawer-divider"></div>

          <%= link_to "Samlingar", collections_path, class: "navbar--drawer-sublink" %>
          <%= link_to "Profil", profile_path, class: "navbar--drawer-sublink" %>
          <%= button_to "Logga ut", session_path, method: :delete, class: "navbar--drawer-sublink" %>
        </div>
      </nav>
    <% end %>
</header>
