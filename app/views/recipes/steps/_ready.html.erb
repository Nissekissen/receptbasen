<%= render "recipes/step_indicators", active: 1 %>

<div class="recipe-flow--viewport" data-recipe-flow-target="viewport">
  <div class="recipe-flow--track" data-recipe-flow-target="track" data-collections-loaded="<%= local_assigns.key?(:collections) %>">
    <div class="recipe-flow--panel" data-recipe-flow-target="panel">
      <%= render "recipes/preview_card", recipe: recipe %>
      <%= render "recipes/actions", recipe: recipe, label: "Nästa", action: "recipe-flow#advance" %>
    </div>

    <div class="recipe-flow--panel" data-recipe-flow-target="panel">
      <%= form_with url: saved_recipes_path, method: :post, id: "save-recipe-form" do |form| %>
        <%= form.hidden_field :recipe_id, value: recipe.id %>
        <%= render "recipes/collection_select", recipe: recipe, collections: local_assigns[:collections] %>
      <% end %>
      <%= render "recipes/actions", recipe: recipe, label: "Spara", form: "save-recipe-form" %>
    </div>
  </div>
</div>
