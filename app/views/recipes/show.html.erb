<% if @recipe.published? %>
  <%= render "recipes/detail", recipe: @recipe %>
<% else %>
  <%= turbo_stream_from "recipe_#{@recipe.id}_loading" %>

  <section class="recipe-flow">
    <div class="recipe-flow--card" id="recipe_card" data-controller="recipe-flow" data-recipe-flow-authenticated-value="<%= authenticated? %>">
      <%= render "recipes/steps/#{recipe_flow_step(@recipe)}", recipe: @recipe, collections: @collections %>
    </div>
  </section>
<% end %>
