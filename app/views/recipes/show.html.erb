<section class="recipe-loading">
    <div class="recipe-loading--card">
        <p class="recipe-loading--title">Sparar ditt recept</p>
        <p class="recipe-loading--url">exempel.se/recept/kladdkaka</p>

        <div class="recipe-loading--step is-done">
            <span class="recipe-loading--icon">&#10003;</span>
            <span>Hämtade receptet</span>
        </div>

        <div class="recipe-loading--step is-failed">
            <span class="recipe-loading--icon">&times;</span>
            <span>Tolkade receptet</span>
        </div>

        <div class="recipe-loading--step is-active">
            <span class="recipe-loading--icon recipe-loading--spinner"></span>
            <span>Tolkar med AI istället</span>
        </div>

        <div class="recipe-loading--step is-pending">
            <span class="recipe-loading--icon"></span>
            <span>Tolkar taggar</span>
        </div>

        <div class="recipe-loading--actions">
            <button type="button" class="btn btn--secondary">Avbryt</button>
            <button type="button" class="btn btn--secondary" disabled>Nästa</button>
        </div>
    </div>
</section>
