<div class="recipe-preview<%= " recipe-preview--card" if local_assigns[:index_card] %>">
  <div class="recipe-preview--image-wrap">
    <% if recipe.image_url.present? %>
      <img src="<%= recipe.image_url %>" alt="" class="recipe-preview--image">
    <% else %>
      <div class="recipe-preview--image recipe-preview--image-placeholder" aria-hidden="true"></div>
    <% end %>

    <% if local_assigns[:index_card] %>
      <% average, count = recipe_rating(recipe) %>
      <% if count > 0 %>
        <span class="recipe-preview--rating" aria-hidden="true">
          <%= render "icons/star", filled: true %>
          <%= number_with_precision(average, precision: 1) %> (<%= count %>)
        </span>
      <% else %>
        <span class="recipe-preview--rating-prompt" aria-hidden="true">Bli först att betygsätta</span>
      <% end %>
    <% end %>
  </div>

  <div class="recipe-preview--body">
    <p class="recipe-preview--title"><%= local_assigns[:truncate_title] ? truncate(recipe.title, length: truncate_title) : recipe.title %></p>

    <% if local_assigns[:attribution] %>
      <p class="recipe-preview--attribution" >
        Sparad av <%= attribution.user.name %> i <%= attribution.collection.name %>
      </p>
    <% end %>

    <% if local_assigns[:index_card] && recipe.source_domain.present? %>
      <p class="recipe-preview--source"><%= recipe.source_domain %></p>
    <% end %>
  </div>
</div>
