<div class="recipe-preview<%= " recipe-preview--card" if local_assigns[:index_card] %>">
  <% if recipe.image_url.present? %>
    <div class="recipe-preview--image-wrap">
      <img src="<%= recipe.image_url %>" alt="" class="recipe-preview--image">

      <% if local_assigns[:index_card] %>
        <span class="recipe-preview--save" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 4h12v16l-6-4-6 4V4Z"/>
          </svg>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="recipe-preview--body">
    <p class="recipe-preview--title"><%= recipe.title %></p>

    <div class="recipe-preview--meta">
      <% if (total_time = recipe_total_time(recipe)) %>
        <span class="recipe-preview--badge">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"/>
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 7.5V12l3 2"/>
          </svg>
          <%= total_time %>
        </span>
      <% end %>
      <% if (difficulty = recipe_difficulty(recipe)) %>
        <span class="recipe-preview--badge">
          <%= render "icons/#{recipe_difficulty_icon(difficulty)}" %>
          <%= difficulty %>
        </span>
      <% end %>
    </div>

    <% if local_assigns[:index_card] && recipe.source_domain.present? %>
      <p class="recipe-preview--source"><%= recipe.source_domain %></p>
    <% end %>
  </div>
</div>
