<% average, count = recipe_rating(recipe) %>
<% rounded_average = average&.round || 0 %>

<div class="recipe-detail--rating" id="recipe_rating">
  <span class="recipe-detail--rating-stars" aria-hidden="true">
    <% (1..5).each do |n| %>
      <%= render "icons/star", filled: n <= rounded_average %>
    <% end %>
  </span>

  <span class="recipe-detail--rating-summary">
    <% if count > 0 %>
      <%= number_with_precision(average, precision: 1) %> (<%= count %> betyg)
    <% else %>
      Inga betyg än
    <% end %>
  </span>
</div>
