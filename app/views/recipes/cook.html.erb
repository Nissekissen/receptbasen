<% content_for :title, "Tillagning – #{@recipe.title}" %>

<% total_steps = @recipe.steps.size %>
<% single_step = total_steps <= 1 %>

<main class="cook-mode" data-controller="cook-mode" data-cook-mode-total-value="<%= total_steps %>">
  <header class="cook-mode--header">
    <%= link_to recipe_path(@recipe), class: "cook-mode--exit", "aria-label": "Avsluta tillagningsläge" do %>
      <%= render "icons/close" %>
    <% end %>
    <p class="cook-mode--title"><%= @recipe.title %></p>
    <span class="cook-mode--wakelock" data-cook-mode-target="wakeLock" title="Skärmen hålls vaken">
      <%= render "icons/eye" %>
    </span>
  </header>

  <div class="cook-mode--progress">
    <div class="cook-mode--progress-track">
      <div class="cook-mode--progress-fill" data-cook-mode-target="progressFill" style="width: <%= (100.0 / total_steps).round(2) %>%"></div>
    </div>
    <p class="cook-mode--progress-label" data-cook-mode-target="counter">Steg 1 av <%= total_steps %></p>
  </div>

  <div class="cook-mode--steps">
    <% @recipe.steps.each.with_index do |step, index| %>
      <div class="cook-mode--step" data-cook-mode-target="step" <%= "hidden" if index != 0 %>>
        <p class="cook-mode--step-text"><%= step.content %></p>

        <% if (duration = step_duration_seconds(step)) %>
          <%= render "recipes/cook_timer_chip", duration: duration %>
        <% end %>
      </div>
    <% end %>
  </div>

  <details class="cook-mode--preview" data-cook-mode-target="preview" <%= "hidden" if single_step %>>
    <summary>Nästa: <span data-cook-mode-target="previewLabel"><%= @recipe.steps[1]&.content %></span></summary>
    <ul class="cook-mode--preview-list" data-cook-mode-target="previewList"></ul>
  </details>

  <details class="cook-mode--ingredients">
    <summary>Ingredienser</summary>
    <ul class="cook-mode--ingredients-list">
      <% @recipe.ingredients.each do |ingredient| %>
        <li>
          <% if (amount = ingredient.formatted_amount) %>
            <span class="cook-mode--ingredient-amount"><%= amount %></span>
          <% end %>
          <span><%= ingredient.display_name %></span>
        </li>
      <% end %>
    </ul>
  </details>

  <div class="cook-mode--nav">
    <button type="button" class="btn btn--secondary cook-mode--prev" data-cook-mode-target="prevButton" data-action="cook-mode#previous" disabled>Föregående</button>
    <button type="button" class="btn btn--primary cook-mode--next" data-cook-mode-target="nextButton" data-action="cook-mode#next" <%= "hidden" if single_step %>>Nästa steg</button>
    <%= button_to "Markera som lagad", log_cook_recipe_path(@recipe), method: :post,
          class: "btn btn--primary cook-mode--finish",
          form: { class: "cook-mode--finish-form", data: { cook_mode_target: "finishForm" }, hidden: !single_step } %>
  </div>
</main>
